// A loop that reads a field through a function that returns it: the return retains the field's object, and the caller releases its count.
class Box {
    public i32 value;
}

class Holder {
    public Box item;
}

Box peek(Holder holder) {
    return holder.item;
}

i32 main() {
    Holder holder = new Holder();
    holder.item = new Box();
    holder.item.value = 3;
    i32 total = 0;
    i32 i = 0;
    while (i < 10000000) {
        Box seen = peek(holder);
        total = total + seen.value;
        i = i + 1;
    }
    return total % 256;
}
