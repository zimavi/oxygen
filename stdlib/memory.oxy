module std.memory;

@extern("oxygen_alloc")
extern void* allocate(u64 size);

@extern("oxygen_free")
extern void deallocate(void* pointer);

@extern("oxygen_realloc")
extern void* reallocate(void* pointer, u64 size);

// The byte size of count elements, which stops the program if it overflows.
@extern("oxygen_array_size")
extern u64 arrayBytes(u64 count, u64 elementSize);

public T* alloc<T>(u64 count) {
    return cast<T*>(allocate(arrayBytes(count, sizeof<T>())));
}

public void free<T>(T* pointer) {
    deallocate(cast<void*>(pointer));
}

public T* realloc<T>(T* pointer, u64 count) {
    return cast<T*>(reallocate(cast<void*>(pointer), arrayBytes(count, sizeof<T>())));
}
