module std.collection;

import std.exception;
import std.memory;

// The canonical optional value used by collection APIs.  Option is a tagged
// union; callers should inspect it with a switch before using a Some payload.
public union Option<T> {
    Some(T);
    None;
}

public union Result<T, E> {
    Ok(T);
    Err(E);
}

public bool is_some<T>(Option<T> value) {
    switch (value) {
        case Some(item): return true;
        case None: return false;
    }
}

public bool is_none<T>(Option<T> value) {
    return !is_some(value);
}

// Returns the value of a Some. A None throws a RuntimeException: taking the value of an absent option is a failure, not an
// expected outcome, so the caller can catch it but does not have to check for it.
public T unwrap<T>(Option<T> value) {
    switch (value) {
        case Some(item): return item;
        case None: throw new RuntimeException("unwrap called on None");
    }
}

public T unwrap_or<T>(Option<T> value, T fallback) {
    switch (value) {
        case Some(item): return item;
        case None: return fallback;
    }
}

public bool is_ok<T, E>(Result<T, E> value) {
    switch (value) {
        case Ok(item): return true;
        case Err(error): return false;
    }
}

public bool is_err<T, E>(Result<T, E> value) {
    return !is_ok(value);
}

// Returns the value of an Ok. An Err throws a RuntimeException, for the same reason as unwrap on an Option.
public T unwrap<T, E>(Result<T, E> value) {
    switch (value) {
        case Ok(item): return item;
        case Err(error): throw new RuntimeException("unwrap called on Err");
    }
}

public T unwrap_or<T, E>(Result<T, E> value, T fallback) {
    switch (value) {
        case Ok(item): return item;
        case Err(error): return fallback;
    }
}

interface Iterator<T> {
	Option<T> next();
}

interface Iterable<T> {
    Iterator<T> iter();
}

// A growable list. append adds a value at the end and doubles the storage when it is full. get and pop return an Option,
// because an index past the end and an empty list are expected outcomes. The list owns its storage, which it frees when it
// is destroyed.
public class List<T> {
    private T* data;
    public u64 length { get; private set; }
    public u64 capacity { get; private set; }

    public void append(T value) {
        if (length == capacity) {
            this.grow();
        }
        data[length] = value;
        length = length + 1;
    }

    public Option<T> pop() {
        if (length == 0) {
            return Option<T>.None;
        }
        length = length - 1;
        return Option<T>.Some(data[length]);
    }

    public Option<T> get(u64 index) {
        if (index >= length) {
            return Option<T>.None;
        }
        return Option<T>.Some(data[index]);
    }

    public ListIterator<T> iter() {
        return new ListIterator<T>(this);
    }

    private void grow() {
        u64 next = 4;
        if (capacity != 0) {
            next = capacity * 2;
        }
        data = memory.realloc<T>(data, next);
        capacity = next;
    }

    public ~List() {
        memory.free(data);
    }
}

// Walks a list from its first value. A position past the end gives None.
class ListIterator<T> : Iterator<T> {
    private List<T> items;
    private u64 position = 0;

    public ListIterator(List<T> items) {
        this.items = items;
    }

    public Option<T> next() {
        Option<T> item = items.get(position);
        position = position + 1;
        return item;
    }
}