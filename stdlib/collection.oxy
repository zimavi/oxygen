module std.collection;

// The canonical optional value used by collection APIs.  Option is a tagged
// union; callers should inspect it with a switch before using a Some payload.
public union Option<T> {
    Some(T);
    None;
}

public union Result<T, E> {
    Ok(T);
    Err(E);
}

interface Iterator<T> {
	Option<T> next();
}

interface Iterable<T> {
    Iterator<T> iter();
}