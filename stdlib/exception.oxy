module std.exception;

// Public value types used by exception handlers and standard-library
// formatters.  The runtime ABI stores the same information as a compact,
// address-stable record; these types keep formatting policy in Oxygen.
public class Frame {
    public string function_name;
    public string file_name;
    public u32 line;
    public u32 column;

    public Frame(string function_name, string file_name, u32 line, u32 column) {
        this.function_name = function_name;
        this.file_name = file_name;
        this.line = line;
        this.column = column;
    }

    internal Frame(void* native_frame) {
        this.function_name = std.exception.from_c_string(
            std.exception.runtime_frame_function_name(native_frame));
        this.file_name = std.exception.from_c_string(
            std.exception.runtime_frame_file_name(native_frame));
        this.line = std.exception.runtime_frame_line(native_frame);
        this.column = std.exception.runtime_frame_column(native_frame);
    }
}

@extern("oxygen_c_string_to_string")
public extern string from_c_string(i8* value);

public class StackTrace {
    public u64 count;
    internal Exception exception_object;

    internal StackTrace(u64 count) {
        this.count = count;
    }

    internal StackTrace(Exception exception_object) {
        this.count = std.exception.runtime_trace_count(exception_object);
        this.exception_object = exception_object;
    }

    public Frame frame_at(u64 index) {
        return new Frame(std.exception.runtime_trace_frame(exception_object, index));
    }
}

@extern("__oxygen_runtime_exception_trace_count")
public extern u64 runtime_trace_count(Exception exception_object);
@extern("__oxygen_runtime_exception_trace_frame")
public extern void* runtime_trace_frame(Exception exception_object, u64 index);
@extern("__oxygen_runtime_trace_frame_function_name")
public extern i8* runtime_frame_function_name(void* frame);
@extern("__oxygen_runtime_trace_frame_file_name")
public extern i8* runtime_frame_file_name(void* frame);
@extern("__oxygen_runtime_trace_frame_line")
public extern u32 runtime_frame_line(void* frame);
@extern("__oxygen_runtime_trace_frame_column")
public extern u32 runtime_frame_column(void* frame);

public class Exception {
    public string message;
    public StackTrace stack_trace;

    public Exception(string message) {
        this.message = message;
        this.stack_trace = new StackTrace(this);
    }
}
