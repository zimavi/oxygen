<Project>

  <!-- The LLVM versions the compiler is built against. LLVMSharp.Interop 22.1.8 depends on libLLVM 22.1.8 and on the
       libLLVMSharp 22.1.8.1 shim, and its bindings call the LLVM-C API of that version. libLLVM must stay at the same
       version, or the compiler loads an LLVM whose C API the bindings were not built for. Change both values together. -->
  <PropertyGroup>
    <LLVMSharpVersion>22.1.8</LLVMSharpVersion>
    <LibLLVMVersion>22.1.8</LibLLVMVersion>
  </PropertyGroup>

  <!-- The version of the compiler, its libraries and its release archives. The VERSION file at the repository root is the one place
       it is written; the scripts and the release workflow read the same file. -->
  <PropertyGroup>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
  </PropertyGroup>

  <!-- A compiler warning fails the build, so a warning is fixed or suppressed on purpose, not left to accumulate. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
